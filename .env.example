# 复制为 .env 后按需修改（放在项目根目录或 backend-rust 目录下均可）
# 完整说明见 README.md 的「环境变量」一节

# ---------- 基础 ----------

# 服务监听地址
BIND_ADDR=127.0.0.1:8000

# 内容根目录（默认从 backend-rust/ 启动，根目录即 ..）
#WANLE_ROOT=..

# 首次启动且 users.txt 中没有任何管理员时，用它自动创建管理员
# ADMIN_PASSWORD 留空则随机生成并打印到启动日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 认证 ----------

# JWT 密钥：请改成足够长的随机字符串
# 不设置时会随机生成一个临时密钥，服务重启后所有登录状态失效
JWT_SECRET=please-change-me-to-a-long-random-string

# 登录有效期（小时），默认 24
JWT_TTL_HOURS=24

# 密钥文件路径（优先于 JWT_SECRET）
#JWT_SECRET_FILE=

# ---------- 存储路径（一般不需要改）----------

#POSTS_DIR=
#DATA_DIR=
#COMMENTS_DIR=
#USERS_FILE=
#STATIC_DIR=
#UPLOADS_DIR=

# ---------- 邮件验证码 ----------

# 邮件模式
#MAIL_MODE=

# SMTP 服务器
#SMTP_HOST=smtp.qq.com
#SMTP_PORT=465
#SMTP_USER=your@qq.com
# 注意：QQ 邮箱这里填「授权码」，不是登录密码
#SMTP_PASS=
# 发件人显示
#SMTP_FROM=wanle <your@qq.com>

# 验证码有效期（分钟）
#VERIFY_TTL_MINUTES=10
# 重发间隔（秒）
#VERIFY_RESEND_SECONDS=60

# ---------- 视频转码 ----------

#FFMPEG_BIN=ffmpeg
# 部分发行版（如 OpenCloudOS/EPEL）打包的 ffmpeg 不含 libx264
#FFMPEG_ENCODER=libx264

# ---------- 其他 ----------

# 评论是否需要审核
#WANLE_COMMENT_REVIEW=true
